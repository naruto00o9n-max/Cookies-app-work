{
  "expo": {
    "name": "Cookies",
    "slug": "cookies-team",
    "scheme": "cookiestracker",
    "version": "1.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "team.cookies.tracker"
    },
    "android": {
      "package": "team.cookies.tracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08090D"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "owner": "zeus313",
    "extra": {
      "eas": {
        "projectId": "54087d37-25eb-4485-9a4d-58c8af5c121a"
      }
    }
  }
}
